{
  "name": "moondeck-apollo",
  "version": "0.1.0",
  "description": "Moonlight (Apollo) launch button on Steam Gaming Mode game pages",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run test:frontend && pnpm run test:backend",
    "test:frontend": "vitest run",
    "test:backend": "python3 -m unittest discover -s tests -v",
    "package": "bash scripts/package.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pitris/Moondeck.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "moonlight",
    "apollo",
    "steamos"
  ],
  "author": "pitris",
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.16.5",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "rollup": "^4.53.3",
    "typescript": "^5.9.3",
    "vitest": "3.2.4"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "tslib": "^2.8.1"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
